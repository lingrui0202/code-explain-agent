# 复制本文件为 .env 并填入你的 Key（.env 不会被提交到仓库）

# 服务商：deepseek | qwen | openai | moonshot | ollama | custom | offline
PROVIDER=deepseek

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖模型与地址
# MODEL=deepseek-chat
# BASE_URL=https://api.deepseek.com
# TEMPERATURE=0.2
